@page "/"

<PageTitle>Reflex Rush</PageTitle>

<div class="game-page">

    <header class="game-header">
        <img src="images/logo.png"
             alt="Reflex Rush"
             class="game-logo" />
    </header>

    <div class="stats-panel">

        <div class="stat">
            <span class="stat-label">Score</span>
            <span class="stat-value">120</span>
        </div>

        <div class="stat">
            <span class="stat-label">Streak</span>
            <span class="stat-value">5</span>
        </div>

        <div class="stat">
            <span class="stat-label">Targets Hit</span>
            <span class="stat-value">12</span>
        </div>

        <div class="stat">
            <span class="stat-label">Missed</span>
            <span class="stat-value">1</span>
        </div>

    </div>

    <div class="timer-panel">

      <span class="timer-label">Time Left</span>
      <span class="timer-value">00:28</span>

    </div>

    <div class="game-area">

      <div class="target target-pink"></div>
      <div class="target target-cyan"></div>
      <div class="target target-orange"></div>
      <div class="target target-purple"></div>
      <div class="target target-green"></div>

      <div class="instructions-panel">
        <h2>How to Play</h2>

        <p>Click the targets</p>
        <p>Get a higher score</p>
        <p>They appear faster each round</p>
      </div>

      <button class="btn start-button">
          <i class="bi bi-play-fill"></i>
          Start Game
      </button>

    </div>

</div>
